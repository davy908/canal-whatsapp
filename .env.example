# Modelo do que vai no Ambiente do serviço no EasyPanel. Nunca coloque valor real neste arquivo.
EVOLUTION_TOKEN_INSTANCIA=chave-da-instancia-canal-ia-nunca-a-geral
CANAL_CHAVE_LEITURA=gerada-pelo-preparar_chaves.ps1
CANAL_SENHA_PAINEL=gerada-pelo-preparar_chaves.ps1
CANAL_NUMERO_ESPERADO=5511999999999
CANAL_DIAS_GUARDA=7
# Agenda: para quem o Claude pode enviar quando o Davy pede (nome:numero, separados por ;).
# CANAL_CONTATOS=andre:5511999990000;lisa:5524999990000
# Quem acorda o canal como se fosse o Davy, e a quem o Claude responde sozinho (só nomes da agenda).
# CANAL_CONTATOS_WEBHOOK=andre
# Só mude se o serviço tiver outro nome no EasyPanel:
# EVOLUTION_URL=http://acelera_so_evolution-api:8080
# CANAL_URL_WEBHOOK=http://acelera_so_canal-whatsapp:8000/webhook/evolution

# --- Várias pessoas no mesmo serviço (opcional) ---
# Com CANAL_PESSOAS, as variáveis acima de uma pessoa só deixam de valer: cada pessoa tem as suas.
# CANAL_PESSOAS=davy,danilo
# CANAL_DAVY_INSTANCIA=canal-ia                  # sem esta linha: canal-<nome>
# CANAL_DAVY_BANCO=/data/canal.db                # sem esta linha: /data/<nome>.db
# CANAL_DAVY_EVOLUTION_TOKEN=chave-da-instancia-dele-nunca-a-geral
# CANAL_DAVY_CHAVE_HASH=gerado-pelo-preparar_chaves.ps1-com--Nome
# CANAL_DAVY_SENHA_PAINEL_HASH=gerado-pelo-preparar_chaves.ps1-com--Nome
# CANAL_DAVY_NUMERO=5511999999999
# CANAL_DAVY_NUMERO_INSTINCT=                    # sem esta linha: a pessoa não tem Instinct
# CANAL_DAVY_CONTATOS=andre:5511999990000
# CANAL_DAVY_CONTATOS_WEBHOOK=andre
